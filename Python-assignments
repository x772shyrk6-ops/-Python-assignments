6) Daire Çevresi ve Alanı (h1s6.py):
import math

# Kullanıcıdan yarıçapı al
yaricap = float(input("Dairenin yarıçapını giriniz: "))

# Hesaplamalar
# Alan = π * r^2
alan = math.pi * (yaricap ** 2)
# Çevre = 2 * π * r
cevre = 2 * math.pi * yaricap

# Sonuçları ekrana yazdır (virgülden sonra 2 basamak)
print(f"Dairenin Alanı: {alan:.2f}")
print(f"Dairenin Çevresi: {cevre:.2f}")





7) Alışveriş Kasası (h1s7.py):


# Ürün veritabanı (Fiyatlar TL cinsinden)
urunler = {
    1: {"ad": "Süt", "fiyat": 25.0},
    2: {"ad": "Ekmek", "fiyat": 10.0},
    3: {"ad": "Peynir", "fiyat": 120.0},
    4: {"ad": "Yumurta (10'lu)", "fiyat": 45.0}
}

sepet = []
kdv_orani = 0.20 # %20 KDV

def menuyu_goster():
    print("\n--- Market Ürünleri ---")
    for kod, detay in urunler.items():
        print(f"{kod} - {detay['ad']}: {detay['fiyat']} TL")

def sepeti_goster():
    print("\n--- Alışveriş Sepetiniz ---")
    if not sepet:
        print("Sepetiniz boş.")
        return 0
    
    toplam = 0
    for i, urun in enumerate(sepet, 1):
        print(f"{i}. {urun['ad']} - {urun['fiyat']} TL")
        toplam += urun['fiyat']
    
    print("-" * 25)
    print(f"Ara Toplam: {toplam:.2f} TL")
    return toplam

# Ana Döngü
while True:
    menuyu_goster()
    islem = input("\nEklemek istediğiniz ürün kodunu girin (Çıkış için 'q', Fiş için 't'): ").lower()

    if islem == 'q':
        print("Sistemden çıkılıyor. İyi günler!")
        break
    
    elif islem == 't':
        ara_toplam = sepeti_goster()
        if ara_toplam > 0:
            kdv = ara_toplam * kdv_orani
            genel_toplam = ara_toplam + kdv
            print(f"KDV (%%{int(kdv_orani*100)}): {kdv:.2f} TL")
            print(f"Ödenecek Tutar: {genel_toplam:.2f} TL")
            print("--- Bizi tercih ettiğiniz için teşekkür ederiz ---")
            break
        
    else:
        try:
            urun_kodu = int(islem)
            if urun_kodu in urunler:
                sepet.append(urunler[urun_kodu])
                print(f"'{urunler[urun_kodu]['ad']}' sepete eklendi.")
            else:
                print("Geçersiz ürün kodu!")
        except ValueError:
            print("Lütfen geçerli bir işlem veya ürün kodu girin.")

