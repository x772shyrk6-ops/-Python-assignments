3) Santigrat → Fahrenhayt (h1s3.py):

# Santigrat'ı Fahrenhayt'a Çevirme
# Formül: (C * 9/5) + 32

def celsius_to_fahrenheit():
    try:
        # Kullanıcıdan girdi al
        celsius = float(input("Santigrat (°C) değerini girin: "))
        
        # Dönüşüm hesabı
        fahrenheit = (celsius * 9/5) + 32
        
        # Sonucu yazdır
        print(f"{celsius}°C = {fahrenheit}°F")
        
    except ValueError:
        print("Lütfen geçerli bir sayı girin.")

# Fonksiyonu çalıştır
if __name__ == "__main__":
    celsius_to_fahrenheit()


